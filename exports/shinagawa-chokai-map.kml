      <ExtendedData>
        <Data name="町会・自治会名">
          <value>小関親睦会</value>
        </Data>
        <Data name="公式町会名">
          <value>小関親睦会</value>
        </Data>
        <Data name="地域区分">
          <value>品川第一地域</value>
        </Data>
        <Data name="住所区域">
          <value>北品川5丁目 3番～9番 / 北品川5丁目 10番（1～3号）</value>
