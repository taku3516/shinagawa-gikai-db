{
  "firestore": {
    "rules": "firebase/firestore.rules"
  },
  "hosting": {
    "public": "_news-app",
    "ignore": [
      "**/.*"
    ],
    "cleanUrls": false,
    "headers": [
      {
        "source": "/news.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/data/news-items.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}
